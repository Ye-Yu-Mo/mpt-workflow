{
  "name": "mpt-workflow",
  "version": "0.3.0",
  "description": "A local MCP server, CLI and dashboard that turn a multi-agent, multi-repo PLAN/TODO/accept/commit workflow into an enforceable state machine.",
  "type": "module",
  "bin": {
    "mpt-workflow": "dist/cli.js",
    "mpt": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "multi-agent",
    "workflow",
    "state-machine",
    "monorepo",
    "agents",
    "tui",
    "dashboard"
  ],
  "author": "Ye-Yu-Mo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:Ye-Yu-Mo/mpt-workflow.git"
  },
  "homepage": "https://github.com/Ye-Yu-Mo/mpt-workflow#readme",
  "bugs": {
    "url": "https://github.com/Ye-Yu-Mo/mpt-workflow/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
